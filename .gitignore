# General rules for the whole repo.
# Technology-specific rules live in backend/.gitignore and frontend/.gitignore.

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets
.history/
*.vsix
*.code-workspace

# Claude Code (personal settings stay local; .claude/settings.json is shared)
.claude/settings.local.json
CLAUDE.local.md

# Secrets / environment
.env
.env.*
!.env.example
*.pem
*.key

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
.fseventsd
.TemporaryItems
.DocumentRevisions-V100

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/
*.lnk
*.stackdump

# Logs
*.log

# Ruff (ruff.toml is at the root, so its cache appears here)
.ruff_cache/

# SPHEREx data and caches (each cutout is ~4 MB); scripts run from the root
cache/
*.fits
*.fits.gz
*.fz

# Python caches of root-level scripts (science/, scripts/)
__pycache__/
*.py[cod]
