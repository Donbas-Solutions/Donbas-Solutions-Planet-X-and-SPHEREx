# Optional overrides for `docker compose up`; copy to .env. No secrets are needed: every data source is public.
# BIND_ADDR=127.0.0.1
# PORT=8080
# Must list the page origin when PORT or the host name changes.
# CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# IRSA_MAX_CONCURRENCY=8
# MAX_RUNNING_JOBS=2
# PIPELINE_WORKERS=2
# LIVE_CAP_PER_DETECTOR=8
# RAW_CACHE_MAX_MB=5000
# PROCESSED_TTL_H=24
